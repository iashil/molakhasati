rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAccount() {
      return signedIn()
        && request.auth.token.account == true
        && accountSessionIsActive();
    }

    function accountSessionIsActive() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userData = get(userPath).data;
      return exists(userPath)
        && userData.status == 'active'
        && request.auth.token.auth_time >= userData.authTimeFloor;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && accountSessionIsActive()
        && adminRoleIsActive();
    }

    function adminRoleIsActive() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userData = get(userPath).data;
      return exists(userPath) && userData.role == 'admin';
    }

    function isConversationParticipant(conversationId) {
      let conversation = get(/databases/$(database)/documents/chat_conversations/$(conversationId));
      return isAccount()
        && request.auth.uid in conversation.data.participantIds;
    }

    match /account_usernames/{usernameKey} {
      allow read, write: if false;
    }

    match /admin_message_access/{accessId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'guest'
        && request.resource.data.isGuest == true;
      allow update: if (isAdmin())
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.name == resource.data.name
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'bio', 'photoURL', 'image', 'lastSeenAt', 'lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create, update: if isAccount() || isAdmin();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update: if isAccount() || isAdmin();
      allow delete: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow create: if isAccount();
      allow read: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /chat_conversations/{conversationId} {
      allow read: if isAccount()
        && request.auth.uid in resource.data.participantIds;
      allow create, update: if false;
      allow delete: if false;

      match /chat_messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}
